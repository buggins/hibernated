/**
 * HibernateD - Object-Relation Mapping for D programming language, with interface similar to Hibernate.
 *
 * Hibernate documentation can be found here:
 * $(LINK http://hibernate.org/docs)$(BR)
 *
 * Source file hibernated/dialects/clickhousedialect.d.
 *
 * This module contains implementation of ClickHouseDialect class which provides implementation specific SQL syntax information.
 *
 * ClickHouse is an analytics database, and differs from the other supported databases:
 * $(UL
 *   $(LI Tables are created with `ENGINE = MergeTree`, ordered by the primary key.)
 *   $(LI Updates run as `ALTER TABLE ... UPDATE` mutations, synchronously (`mutations_sync = 2`). They are
 *        much more expensive than in an OLTP database: fine for occasional changes, not for update-heavy use.)
 *   $(LI There are no transactions: beginning one throws `HibernatedException`.)
 *   $(LI There are no foreign keys and no unique constraints; they are left out of the schema.)
 *   $(LI `@Generated` keys are generated by the client before the insert: unique 64-bit ids (time-based)
 *        for `long`/`ulong` keys, UUIDs for string keys, and `max(key) + 1` for narrower integer keys, which
 *        is only safe with a single writer.)
 * )
 *
 * Use it with the ddbc `ClickHouse` configuration.
 *
 * Copyright: Copyright 2026
 * License:   $(LINK www.boost.org/LICENSE_1_0.txt, Boost License 1.0).
 * Author:   Vadim Lopatin
 */
module hibernated.dialects.clickhousedialect;

import std.conv;
import std.variant : Variant;

import hibernated.dialect : Dialect;
import hibernated.metadata;
import hibernated.type;
import ddbc.core : Connection, ResultSet, SqlType, Statement;

/// Words that are quoted when used as identifiers.
string[] CLICKHOUSE_RESERVED_WORDS =
    [
     "ALL", "ALTER", "AND", "ANY", "ARRAY", "AS", "ASC", "BETWEEN", "BY", "CASE", "CAST", "CREATE", "CROSS",
     "DATABASE", "DEFAULT", "DELETE", "DESC", "DISTINCT", "DROP", "ELSE", "END", "EXISTS", "FINAL", "FORMAT",
     "FROM", "FULL", "GLOBAL", "GROUP", "HAVING", "IF", "IN", "INDEX", "INNER", "INSERT", "INTERVAL", "INTO",
     "IS", "JOIN", "KEY", "LEFT", "LIKE", "LIMIT", "NOT", "NULL", "OFFSET", "ON", "OR", "ORDER", "OUTER",
     "PREWHERE", "PRIMARY", "RIGHT", "SAMPLE", "SELECT", "SET", "SETTINGS", "TABLE", "THEN", "TO", "TOTALS",
     "UNION", "UPDATE", "USING", "VALUES", "WHEN", "WHERE", "WITH",
    ];

class ClickHouseDialect : Dialect {
    ///The character specific to this dialect used to close a quoted identifier.
    override char closeQuote() const { return '`'; }
    ///The character specific to this dialect used to begin a quoted identifier.
    override char  openQuote() const { return '`'; }

    // returns a type like "Int64 PRIMARY KEY", "Nullable(String)" or "Int32 DEFAULT 0"
    override string getColumnTypeDefinition(const PropertyInfo pi, const PropertyInfo overrideTypeFrom = null) {
        immutable Type type = overrideTypeFrom !is null ? overrideTypeFrom.columnType : pi.columnType;
        immutable SqlType sqlType = type.getSqlType();
        bool unsigned = cast(NumberType)type !is null && (cast(NumberType)type).unsigned;
        string base = baseType(sqlType, unsigned);
        bool fk = pi is null;
        if (fk)
            return base; // join table column: part of its primary key, never NULL
        if (pi.key)
            return base ~ " PRIMARY KEY";
        string res = pi.nullable ? "Nullable(" ~ base ~ ")" : base;
        if (pi.generated)
            res ~= " DEFAULT " ~ implicitDefault(sqlType);
        return res;
    }

    override string getCheckTableExistsSQL(string tableName) {
        return "SELECT name FROM system.tables WHERE database = currentDatabase() AND name = " ~ quoteSqlString(tableName);
    }

    /// MergeTree, sorted by the primary key, or by the columns of an `@EmbeddedId`.
    override string getCreateTableSuffix(const string[] embeddedKeyColumns) {
        if (embeddedKeyColumns.length == 0)
            return " ENGINE = MergeTree";
        return " ENGINE = MergeTree ORDER BY " ~ createFieldListSQL(embeddedKeyColumns.dup);
    }

    override string getUpdatePrefix(string quotedTableName) {
        return "ALTER TABLE " ~ quotedTableName ~ " UPDATE ";
    }

    /// Waits until the update has been applied on all replicas.
    override string getUpdateSuffix() {
        return " SETTINGS mutations_sync = 2";
    }

    /// Data-skipping index; ClickHouse has no B-tree secondary indexes.
    override string getIndexSQL(string tableName, string indexName, string[] columnNames) {
        return "ALTER TABLE " ~ quoteIfNeeded(tableName) ~ " ADD INDEX " ~ quoteIfNeeded(indexName) ~ " "
            ~ createFieldListSQL(columnNames) ~ " TYPE minmax GRANULARITY 1";
    }

    override string getDropIndexSQL(string tableName, string indexName) {
        return "ALTER TABLE " ~ quoteIfNeeded(tableName) ~ " DROP INDEX IF EXISTS " ~ quoteIfNeeded(indexName);
    }

    /// Not supported: ClickHouse cannot enforce uniqueness.
    override string getUniqueIndexSQL(string tableName, string indexName, string[] columnNames) {
        return null;
    }

    /// Not supported.
    override string getUniqueIndexItemSQL(string indexName, string[] columnNames) {
        return null;
    }

    /// Not supported: ClickHouse has no foreign keys.
    override string getForeignKeySQL(string tableName, string indexName, string[] columnNames, string referencedTableName, string[] referencedFieldNames) {
        return null;
    }

    /// Not supported.
    override string getDropForeignKeySQL(string tableName, string indexName) {
        return null;
    }

    override bool supportsTransactions() {
        return false;
    }

    override bool supportsGeneratedKeys() {
        return false;
    }

    /// Unique time-based ids for 64-bit keys, UUIDs for string keys, max + 1 for narrower integers.
    override Variant generateKey(Connection conn, const EntityInfo entity) {
        import std.uuid : randomUUID;

        auto key = entity.getKeyProperty();
        immutable SqlType sqlType = key.columnType.getSqlType();
        switch (sqlType) {
            case SqlType.BIGINT:
                return Variant(uniqueId64());
            case SqlType.INTEGER:
            case SqlType.SMALLINT:
            case SqlType.TINYINT:
            case SqlType.NUMERIC:
                Statement stmt = conn.createStatement();
                scope(exit) stmt.close();
                ResultSet rs = stmt.executeQuery("SELECT max(" ~ quoteIfNeeded(key.columnName) ~ ") FROM "
                        ~ quoteIfNeeded(entity.tableName));
                scope(exit) rs.close();
                long next = rs.next() ? rs.getLong(1) + 1 : 1;
                return Variant(next);
            default:
                return Variant(randomUUID().toString());
        }
    }

    this() {
        addKeywords(CLICKHOUSE_RESERVED_WORDS);
    }
}

private string baseType(SqlType sqlType, bool unsigned) {
    switch (sqlType) {
        case SqlType.BIGINT:
            return unsigned ? "UInt64" : "Int64";
        case SqlType.INTEGER:
        case SqlType.NUMERIC:
            return unsigned ? "UInt32" : "Int32";
        case SqlType.SMALLINT:
            return unsigned ? "UInt16" : "Int16";
        case SqlType.TINYINT:
            return unsigned ? "UInt8" : "Int8";
        case SqlType.BIT:
        case SqlType.BOOLEAN:
            return "Bool";
        case SqlType.FLOAT:
            return "Float32";
        case SqlType.DOUBLE:
        case SqlType.DECIMAL:
            return "Float64";
        case SqlType.DATE:
            return "Date32";
        case SqlType.DATETIME:
            return "DateTime";
        default:
            return "String"; // text, binary and time-of-day values
    }
}

private string implicitDefault(SqlType sqlType) {
    switch (sqlType) {
        case SqlType.BIGINT:
        case SqlType.DECIMAL:
        case SqlType.DOUBLE:
        case SqlType.FLOAT:
        case SqlType.INTEGER:
        case SqlType.NUMERIC:
        case SqlType.SMALLINT:
        case SqlType.TINYINT:
            return "0";
        case SqlType.BIT:
        case SqlType.BOOLEAN:
            return "false";
        case SqlType.DATE:
            return "'1970-01-01'";
        case SqlType.DATETIME:
            return "toDateTime(0)"; // the Unix epoch, whatever the server timezone
        default:
            return "''";
    }
}

/// A positive 64-bit id, unique across processes with high probability: milliseconds since 2020
/// (41 bits), a random number chosen per process (10 bits) and a per-process counter (12 bits).
private long uniqueId64() {
    import core.atomic : atomicOp;
    import std.datetime.systime : Clock, SysTime;
    import std.datetime.date : DateTime;
    import std.datetime.timezone : UTC;
    import std.random : uniform;

    static shared long counter;
    static shared long processPart = -1;
    if (processPart < 0)
        processPart = uniform(0L, 1024L);
    immutable long epoch = SysTime(DateTime(2020, 1, 1), UTC()).stdTime;
    immutable long ms = (Clock.currStdTime - epoch) / 10_000;
    immutable long seq = atomicOp!"+="(counter, 1) & 0xFFF;
    return (ms << 22) | (processPart << 12) | seq;
}

unittest {
    auto d = new ClickHouseDialect();
    assert(d.quoteIfNeeded("group") == "`group`");
    assert(d.getUpdatePrefix("`users`") == "ALTER TABLE `users` UPDATE ");
    assert(d.getCreateTableSuffix(null) == " ENGINE = MergeTree");
    assert(d.getCreateTableSuffix(["a", "order"]) == " ENGINE = MergeTree ORDER BY (a, `order`)");
    assert(d.getForeignKeySQL("a", "fk", ["x"], "b", ["id"]) is null);
    assert(baseType(SqlType.BIGINT, true) == "UInt64");
    const long a = uniqueId64(), b = uniqueId64();
    assert(a > 0 && b > 0 && a != b);
}
